# Supabase (Project Settings → API)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Apollo master API key (People Search requires a master key)
APOLLO_API_KEY=your-apollo-master-api-key
APOLLO_API_BASE_URL=https://api.apollo.io/api/v1

# Apollo people list. Newly enriched contacts are saved to your Apollo
# team and added to this list (created automatically if it does not exist).
APOLLO_LIST_NAME=TAM Decision Makers

# Phone webhook (python -m Phonewebhook). Apollo requires public HTTPS.
PHONE_WEBHOOK_PORT=8787
PHONE_WEBHOOK_SECRET=change-me-to-a-long-random-string
# After the webhook is reachable, set this to the printed URL, e.g.
# https://xxxx.trycloudflare.com/apollo/phone?token=change-me-to-a-long-random-string
# or, if deployed on Vercel:
# https://YOUR_PROJECT.vercel.app/apollo/phone?token=change-me-to-a-long-random-string
APOLLO_WEBHOOK_URL=

# Optional: override auto-detected companies table/columns
COMPANIES_TABLE=companies
# COMPANIES_ID_COLUMN=id
# COMPANIES_NAME_COLUMN=name
# COMPANIES_DOMAIN_COLUMN=domain
# COMPANIES_WEBSITE_COLUMN=website
# COMPANIES_EMPLOYEE_COLUMN=employee_count
